{
    "main": {
        "SERVICE_NAME": "smtp",
        "DOMAIN": ""
    },
    "containers": [
        {
            "IMAGE": "safebox/smtp:latest",
            "UPDATE": "true",
            "NAME": "mail-smtp",
            "MEMORY": "128M",
            "SELECTOR": "smtp",
            "VOLUMES": [],
            "PORTS": [
                {
                    "SOURCE": "null",
                    "DEST": "25",
                    "TYPE": "tcp"
                }
            ],
            "READYNESS": [
                {
                    "tcp": ""
                },
                {
                    "HTTP": ""
                },
                {
                    "EXEC": "/ready.sh"
                }
            ],
            "ENVS": [
                {
                    "TZ": "#TZ"
                },
                {
                    "RELAY_HOST": "#RELAY_HOST"
                },
                {
                    "RELAY_PORT": "#RELAY_PORT"
                },
                {
                    "RELAY_USER": "#RELAY_USER"
                },
                {
                    "TEST_EMAIL": "#TEST_EMAIL"
                },
                {
                    "FROMADDRESS": "#FROMADDRESS"
                },
                {
                    "MYNETWORKS": "#MYNETWORKS"
                },
                {
                    "MSG_SIZE": "#MSG_SIZE"
                },
                {
                    "LOG_DISABLE": "#LOG_DISABLE"
                }
            ],
            "ENV_FILES": [
                "/etc/user/secret/smtp/smtp.json"
            ],
            "EXTRA": "null",
            "DEPEND": "null",
            "START_ON_BOOT": "true",
            "CMD": "null",
            "PRE_START": "null",
            "POST_START": "null"
        }
    ]
}