{
    "outlinepostgres": {
        "POSTGRES_DB": "#DB_NAME",
        "POSTGRES_USER": "#DB_USER",
        "POSTGRES_PASSWORD": "#DB_PASSWORD"
    },
    "outlineapp": {
        "SECRET_KEY": "#SECRET_KEY",
        "DATABASE_URL": "postgres://#DB_USER:#DB_PASSWORD@outlinepostgres-db:5432/#DB_NAME"
    }
}